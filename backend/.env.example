# Sunucu / lokal backend ortam örneği — gerçek değerleri .env'e kopyala
PORT=3010
NODE_ENV=development

# CloudPanel örnek:
# DATABASE_URL="mysql://anypay-tahsilat-user:SIFRE@127.0.0.1:3306/anypay-tahsilat-db"
DATABASE_URL="mysql://anypay-tahsilat-user:CHANGE_ME@127.0.0.1:3306/anypay-tahsilat-db"

# En az 32 karakter rastgele bir gizli anahtar kullan
JWT_SECRET="degistir-bu-gizli-anahtari-uzun-ve-rastgele-yap"
JWT_EXPIRES_DAYS=7

# SMTP — hızlı giriş OTP maili (Gmail uygulama şifresi önerilir)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ornek@gmail.com
SMTP_PASS=uygulama-sifresi
SMTP_FROM="Destek <ornek@gmail.com>"

# OTP süresi (dakika)
OTP_EXPIRES_MINUTES=10
