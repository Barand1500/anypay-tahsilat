generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Mevcut `user` tablosu — dump referans; alanlar ihtiyaca göre genişletilir
model User {
  id               Int       @id @default(autoincrement())
  musteriId        Int?      @map("musteri_id")
  email            String    @unique @db.VarChar(180)
  isVerified       Boolean   @map("is_verified")
  isPassword       Boolean   @map("is_password")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  roles            Json
  password         String    @db.VarChar(255)
  adsoyad          String?   @db.VarChar(255)
  unvan            String?   @db.VarChar(255)
  telefon          String    @db.VarChar(255)
  resim            String?   @db.VarChar(255)
  remove           Boolean?
  resetToken       String?   @map("reset_token") @db.VarChar(255)
  karMarji         Float?    @map("kar_marji")
  dogrulama        String?   @db.VarChar(255)
  fbToken          String?   @map("fb_token") @db.VarChar(255)
  lastLogin        DateTime? @map("last_login")
  appleId          String?   @map("apple_id") @db.LongText
  googleId         String?   @map("google_id") @db.LongText
  vegaEntegre      Boolean?  @map("vega_entegre")
  twoFactor        Boolean?  @map("two_factor")
  twoFactorType    Int?      @map("two_factor_type")
  subeDepartmanId  Int?      @map("sube_departman_id")
  /** Çoklu şube — CSV id listesi (1,2,3) */
  subeDepartmanIds String?   @map("sube_departman_ids") @db.LongText
  rolId            Int?      @map("rol_id")
  izinliTaksitler  String?   @map("izinli_taksitler") @db.LongText

  @@map("user")
}

/** Panel modül kayıtları — eski PHP “İzinler” */
model Izinler {
  id              Int       @id @default(autoincrement())
  adi             String    @db.VarChar(255)
  olusturmaTarihi DateTime? @map("olusturma_tarihi")
  remove          Boolean?
  tablo           String?   @db.VarChar(255)
  route           String?   @db.VarChar(255)

  @@map("izinler")
}

/** Roller — izinler alanı PHP serialize (yalnızca okunur bu fazda) */
model Rol {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  code    String   @db.VarChar(255)
  remove  Boolean?
  izinler String?  @db.LongText
  yetki   Int?

  @@map("rol")
}

/** Şube / departman */
model SubeDepartman {
  id              Int      @id @default(autoincrement())
  adi             String   @db.VarChar(255)
  info            String?  @db.LongText
  remove          Boolean?
  izinliTaksitler String?  @map("izinli_taksitler") @db.LongText

  @@map("sube_departman")
}

/** Sürüm geçmişi */
model Surumler {
  id              Int       @id @default(autoincrement())
  tarih           DateTime
  versionNumarasi Float     @map("version_numarasi")
  eklenen         String?   @db.LongText
  cikartilan      String?   @db.LongText
  remove          Boolean?
  duzeltilen      String?   @db.LongText
  durum           Boolean?

  @@map("surumler")
}

/** Panel işlem logları */
model Log {
  id          Int      @id @default(autoincrement())
  kullaniciId Int?     @map("kullanici_id")
  tarih       DateTime
  islem       String?  @db.LongText

  @@map("log")
}

/** E-posta / SMS gönderim geçmişi */
model GonderimGecmisi {
  id        Int      @id @default(autoincrement())
  musteriId Int?     @map("musteri_id")
  tip       String   @db.VarChar(16)
  alici     String   @db.VarChar(255)
  icerik    String?  @db.LongText
  tarih     DateTime
  kaynak    String?  @db.VarChar(64)
  refId     Int?     @map("ref_id")
  basarili  Boolean  @default(true)

  @@index([tarih])
  @@index([musteriId])
  @@map("gonderim_gecmisi")
}

/** Müşteriler / cari hesaplar */
model Musteri {
  id              Int       @id @default(autoincrement())
  kisaAdi         String?   @map("kisa_adi") @db.VarChar(255)
  firmaKodu       String?   @map("firma_kodu") @db.VarChar(255)
  unvan           String?   @db.VarChar(255)
  vn              String?   @db.VarChar(255)
  telefon         String?   @db.VarChar(255)
  eposta          String?   @db.VarChar(255)
  remove          Boolean?
  info            String?   @db.LongText
  vd              Int?
  webSitesi       String?   @map("web_sitesi") @db.VarChar(255)
  tc              String?   @db.VarChar(255)
  pasaportNo      String?   @map("pasaport_no") @db.VarChar(255)
  /** 0=gerçek, 1=tüzel, 2=yabancı */
  musteriTipi     Int?      @map("musteri_tipi")
  cariTipiId      Int?      @map("cari_tipi_id")
  vegaId          Int?      @map("vega_id")
  vegaEntegre     Boolean?  @map("vega_entegre")
  vegaTarih       DateTime? @map("vega_tarih")
  durum           Int?
  ustid           Int?
  adres           String?   @db.LongText
  kartAnlasmaKodu String?   @map("kart_anlasma_kodu") @db.VarChar(255)

  @@map("musteriler")
}

/** Cari tipi (Müşteri, Bayi…) — izinli_taksitler CSV */
model CariTipi {
  id              Int      @id @default(autoincrement())
  adi             String   @db.VarChar(255)
  remove          Boolean?
  izinliTaksitler String?  @map("izinli_taksitler") @db.LongText

  @@map("cari_tipleri")
}

/** Bankalar — sanal POS endpoint’leri dahil */
model Banka {
  id              Int      @id @default(autoincrement())
  adi             String   @db.VarChar(255)
  kisaAdi         String   @map("kisa_adi") @db.VarChar(255)
  logo            String?  @db.VarChar(255)
  /** Örn. 3D,3D_PAY,3D_HOST */
  guvenlikTipleri String?  @map("guvenlik_tipleri") @db.VarChar(255)
  sanalPos3dUrl   String?  @map("sanal_pos_3d_url") @db.VarChar(512)
  sanalPosApiUrl  String?  @map("sanal_pos_api_url") @db.VarChar(512)
  sanalPosXmlUrl  String?  @map("sanal_pos_xml_url") @db.VarChar(512)
  remove          Boolean?

  @@map("bankalar")
}

/** Kart BIN kayıtları — Api Ayarları › BIN (kart → banka eşlemesi) */
model BinKayit {
  id       Int      @id @default(autoincrement())
  bankaId  Int?     @map("banka_id")
  bankaAdi String   @map("banka_adi") @db.VarChar(255)
  bin      String   @db.VarChar(8)
  tip      String?  @db.VarChar(64)
  marka    String?  @db.VarChar(64)
  tur      String?  @db.VarChar(64)
  remove   Boolean?

  @@unique([bin])
  @@index([bankaId])
  @@map("bin_kayitlari")
}

/**
 * Sanal POS tanımları — üye işyeri / terminal / güvenlik anahtarı
 * (eski panel: Sanal POS Tanımları)
 */
model SanalPosTanim {
  id               Int      @id @default(autoincrement())
  bankaId          Int      @map("banka_id")
  altyapiKodu      String   @map("altyapi_kodu") @db.VarChar(64)
  posAdi           String   @map("pos_adi") @db.VarChar(255)
  isyeriNo         String?  @map("isyeri_no") @db.VarChar(255)
  terminalSafeId   String?  @map("terminal_safe_id") @db.VarChar(255)
  guvenlikAnahtari String?  @map("guvenlik_anahtari") @db.VarChar(512)
  /** NestPay / Garanti — terminal / provizyon şifresi */
  terminalSifresi  String?  @map("terminal_sifresi") @db.VarChar(255)
  guvenlikTipi     String?  @map("guvenlik_tipi") @db.VarChar(64)
  varsayilan       Boolean? @default(false)
  aktif            Boolean? @default(true)
  remove           Boolean?

  @@index([bankaId])
  @@map("sanal_pos_tanimlari")
}

/**
 * Ortak Sanal POS — kart bankası → yönlenen bankanın POS’u
 * (eski panel: Ortak Sanal POS Tanımları)
 */
model OrtakSanalPos {
  id               Int      @id @default(autoincrement())
  bankaId          Int      @map("banka_id")
  yonlenenBankaId  Int      @map("yonlenen_banka_id")
  aktif            Boolean? @default(true)
  remove           Boolean?

  @@index([bankaId])
  @@map("ortak_sanal_pos")
}

/** Kart tipi — Banka Kartı / Kredi Kartı … */
model KartTipi {
  id     Int      @id @default(autoincrement())
  adi    String   @db.VarChar(255)
  remove Boolean?

  @@map("kart_tipleri")
}

/** Kart türü — Bireysel / Ticari … */
model KartTuru {
  id     Int      @id @default(autoincrement())
  adi    String   @db.VarChar(255)
  remove Boolean?

  @@map("kart_turleri")
}

/** Kart markası — Visa / MasterCard / TROY … */
model KartMarka {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  logo    String?  @db.VarChar(255)
  kisaKod String?  @map("kisa_kod") @db.VarChar(8)
  remove  Boolean?

  @@map("kart_markalari")
}

/**
 * Kart anlaşmaları — düz satırlar (anlasma_kodu ile paket)
 * UI: paket adı + banka panelleri + taksit oranları
 */
model KartAnlasma {
  id                Int      @id @default(autoincrement())
  adi               String   @db.VarChar(255)
  bankaId           Int?     @map("banka_id")
  taksit            Int
  altLimit          Float?   @map("alt_limit")
  komisyonTum       Float?   @map("komisyon_tum")
  komisyonBireysel  Float?   @map("komisyon_bireysel")
  komisyonTicari    Float?   @map("komisyon_ticari")
  /** Canlı dump: NOT NULL — kayıt anı */
  tarih             DateTime @default(now())
  /** Paket tarihi YYYY-MM-DD */
  grup              String?  @db.VarChar(255)
  blokAdi           String?  @map("blok_adi") @db.VarChar(255)
  blokLogo          String?  @map("blok_logo") @db.VarChar(255)
  /** Banka anlaşması ekstra alanlar (JSON) */
  detay             String?  @db.LongText
  anlasmaKodu       String   @map("anlasma_kodu") @db.VarChar(64)
  remove            Boolean?

  @@index([anlasmaKodu])
  @@index([bankaId])
  @@map("kart_anlasmalari")
}

/**
 * Para birimleri — dump: para_birimleri
 * kur_tipi: 1=Döviz Alış, 2=Döviz Satış, 3=Efektif Alış, 4=Efektif Satış
 */
model Parabirimi {
  id         Int      @id @default(autoincrement())
  adi        String   @db.VarChar(255)
  kisaAdi    String   @map("kisa_adi") @db.VarChar(255)
  sembol     String   @db.VarChar(255)
  kur        Float
  guncelleme Boolean
  apiUrl     String?  @map("api_url") @db.VarChar(255)
  info       String?  @db.LongText
  remove     Boolean?
  kurTipi    Int      @map("kur_tipi")
  aktif      Boolean?
  erp        String?  @db.VarChar(255)
  erpStatus  Boolean? @map("erp_status")

  @@map("para_birimleri")
}

/**
 * Ödemeler / hareketler
 * durum: 1=başarılı, 2=iptal/iade, 0|-1=hatalı
 * odeme_tipi: 0=C/H, 2=fatura (dump)
 */
model Odeme {
  id               Int       @id @default(autoincrement())
  parabirimiId     Int       @map("parabirimi_id")
  musteriId        Int?      @map("musteri_id")
  tutar            Float
  kur              Float?
  komisyonDahil    Boolean   @map("komisyon_dahil")
  aciklama         String?   @db.LongText
  adsoyad          String    @db.VarChar(255)
  tc               String?   @db.VarChar(255)
  telefon          String    @db.VarChar(255)
  kartNo           String    @map("kart_no") @db.VarChar(255)
  taksit           Int?
  taksitOran       Float?    @map("taksit_oran")
  vadeFarki        Float?    @map("vade_farki")
  odemeNo          String    @map("odeme_no") @db.VarChar(255)
  durum            Int
  bankaCevabi      String?   @map("banka_cevabi") @db.LongText
  odemeTipi        Int       @map("odeme_tipi")
  faturaNo         String?   @map("fatura_no") @db.VarChar(255)
  bankError        String?   @map("bank_error") @db.LongText
  tarih            DateTime?
  ip               String?   @db.VarChar(255)
  tahsilGunu       String?   @map("tahsil_gunu") @db.VarChar(255)
  blokeGunu        String?   @map("bloke_gunu") @db.VarChar(255)
  taksitDetay      String?   @map("taksit_detay") @db.LongText
  bankaId          Int?      @map("banka_id")
  sanalposBankaId  Int?      @map("sanalpos_banka_id")
  kurulusId        Int?      @map("kurulus_id")
  bankaKomisyonu   Float?    @map("banka_komisyonu")
  blokeTarih       DateTime? @map("bloke_tarih")
  arsiv            Boolean?
  subeDepartmanId  Int?      @map("sube_departman_id")
  kullaniciId      Int?      @map("kullanici_id")
  iptalIadeHareket String?   @map("iptal_iade_hareket") @db.LongText
  gercekTutar      Float     @map("gercek_tutar")
  epostaGonderildi Int?      @map("eposta_gonderildi")
  smsGonderildi    Int?      @map("sms_gonderildi")

  @@map("odemeler")
}

/** Kullanıcı kasası — şifre ayarı */
model KasaAyar {
  id          Int     @id @default(autoincrement())
  kullaniciId Int     @unique @map("kullanici_id")
  sifreHash   String? @map("sifre_hash") @db.VarChar(255)
  remove      Boolean?

  @@map("kasa_ayar")
}

/** Kasa kayıtları — IBAN / kart vb. */
model KasaKayit {
  id          Int       @id @default(autoincrement())
  kullaniciId Int       @map("kullanici_id")
  tip         String    @db.VarChar(32)
  etiket      String    @db.VarChar(64)
  baslik      String    @db.VarChar(255)
  deger       String    @db.LongText
  sira        Int       @default(0)
  remove      Boolean?
  olusturma   DateTime? @default(now()) @map("olusturma")

  @@index([kullaniciId])
  @@map("kasa_kayitlari")
}

/** OTP — login / şifre sıfırlama / kasa (çok process güvenli) */
model OtpChallenge {
  id        Int      @id @default(autoincrement())
  scope     String   @db.VarChar(64)
  email     String   @db.VarChar(180)
  codeHash  String   @map("code_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)

  @@unique([scope, email])
  @@map("otp_challenge")
}

/** Tanımlamalar › Sözleşmeler — dump: baslik/metin + tip flag’leri */
model Sozlesme {
  id       Int      @id @default(autoincrement())
  baslik   String   @db.VarChar(255)
  metin    String?  @db.LongText
  kvkk     Boolean  @default(false)
  tahsilat Boolean  @default(false)
  iade     Boolean  @default(false)
  remove   Boolean?
  seourl   String?  @db.VarChar(255)
  sira     Int?     @default(0)
  hizmet   Boolean  @default(false)
  guvenlik Boolean  @default(false)
  iletisim Boolean? @default(false)
  uyelik   Boolean? @default(false)

  @@map("sozlesmeler")
}

/** Ödeme istekleri — durum: 0=bekleyen, 1=ödendi */
model OdemeIstegi {
  id              Int       @id @default(autoincrement())
  parabirimiId    Int       @map("parabirimi_id")
  odemeTipi       Int       @map("odeme_tipi")
  tutar           Float
  faturaNo        String?   @map("fatura_no") @db.VarChar(255)
  komisyonDahil   Boolean   @map("komisyon_dahil")
  taksitler       String?   @db.LongText
  aciklama        String?   @db.LongText
  dosya           String?   @db.LongText
  musteriId       Int?      @map("musteri_id")
  tarih           DateTime
  odemeZamani     DateTime? @map("odeme_zamani")
  durum           Boolean
  istekNo         String    @map("istek_no") @db.VarChar(255)
  kullaniciId     Int?      @map("kullanici_id")
  subeDepartmanId Int?      @map("sube_departman_id")
  remove          Boolean?
  qr              String?   @db.VarChar(255)

  @@map("odeme_istekleri")
}

/** Genel sistem ayarları — tek satır (id=1) */
model Ayarlar {
  id                     Int       @id @default(autoincrement())
  sistemAdi              String    @map("sistem_adi") @db.VarChar(255)
  sistemYolu             String    @map("sistem_yolu") @db.VarChar(255)
  logo                   String    @db.VarChar(255)
  favicon                String    @db.VarChar(255)
  sistemPosta            String    @map("sistem_posta") @db.VarChar(255)
  sanalposHedefKullanimi Boolean?  @map("sanalpos_hedef_kullanimi")
  surum                  String?   @db.VarChar(255)
  dbTarih                DateTime? @map("db_tarih")
  bildirimEpostalar      String?   @map("bildirim_epostalar") @db.LongText
  bildirimSmsler         String?   @map("bildirim_smsler") @db.LongText
  binListLink            String?   @map("bin_list_link") @db.VarChar(255)
  ilkBankaCekim          Boolean?  @map("ilk_banka_cekim")
  uygulamaKayit          Boolean?  @map("uygulama_kayit")
  /** Taksit öncelik sırası — CSV: user,cari,sube */
  taksitSiralama         String?   @map("taksit_siralama") @db.VarChar(64)
  /** Panel varsayılanları — JSON */
  varsayilanlar          String?   @map("varsayilanlar") @db.LongText
  /** SMTP ayarları — JSON (host, port, email, password, ssl, tls) */
  smtpAyarlar            String?   @map("smtp_ayarlar") @db.LongText
  /** Meta WhatsApp Cloud API — JSON */
  whatsappAyarlar        String?   @map("whatsapp_ayarlar") @db.LongText
  /** Header hızlı erişim görünürlüğü ve yuva sayısı — JSON */
  hizliErisimAyarlari     String?   @map("hizli_erisim_ayarlari") @db.LongText
  /** Public /pay sayfası — düzen, logo boyutu, rozetler — JSON */
  odemeSayfaAyarlari      String?   @map("odeme_sayfa_ayarlari") @db.LongText

  @@map("ayarlar")
}

/** Zamanlanmış ödeme isteği hatırlatmaları (personel bildirimi) */
model OdemeHatirlatma {
  id              Int       @id @default(autoincrement())
  musteriId       Int       @map("musteri_id")
  kullaniciId     Int       @map("kullanici_id")
  planlananTarih  DateTime  @map("planlanan_tarih")
  aciklama        String?   @db.LongText
  email           Boolean   @default(true)
  sms             Boolean   @default(false)
  whatsapp        Boolean   @default(false)
  /** pending | sent | cancelled */
  durum           String    @db.VarChar(32)
  token           String    @unique @db.VarChar(64)
  olusturmaTarihi DateTime  @map("olusturma_tarihi")
  gonderimTarihi  DateTime? @map("gonderim_tarihi")
  remove          Boolean?

  @@index([planlananTarih])
  @@index([kullaniciId])
  @@map("odeme_hatirlatmalari")
}

/** Şablon değişken tanımları — e-posta/SMS şablonlarının üst kaydı */
model EsSablon {
  id          Int      @id @default(autoincrement())
  modulId     Int      @map("modul_id")
  adi         String   @db.VarChar(255)
  degiskenler String   @db.LongText
  remove      Boolean?
  /** 0=e-posta, 1=sms */
  tip         Int
  kodu        String?  @db.VarChar(255)

  @@map("essablonlar")
}

/** E-posta şablon içerikleri — essablonlar.id ile bağlı */
model EpostaSablon {
  id       Int      @id @default(autoincrement())
  sablonId Int      @map("sablon_id")
  konu     String   @db.VarChar(255)
  icerik   String   @db.LongText
  remove   Boolean?
  info     String?  @db.LongText

  @@map("eposta_sablonlari")
}

/** SMS sağlayıcıları */
model SmsSaglayici {
  id          Int      @id @default(autoincrement())
  adi         String   @db.VarChar(255)
  code        String   @db.LongText
  degiskenler String   @db.LongText
  remove      Boolean?

  @@map("sms_saglayicilari")
}

/** SMS ayarları — tek/az satır */
model SmsAyar {
  id          Int      @id @default(autoincrement())
  saglayiciId Int      @map("saglayici_id")
  degiskenler String   @db.LongText
  status      Boolean?

  @@map("sms_ayarlari")
}

/** SMS şablon içerikleri — essablonlar.id ile bağlı */
model SmsSablon {
  id       Int      @id @default(autoincrement())
  sablonId Int      @map("sablon_id")
  icerik   String   @db.LongText
  info     String?  @db.LongText
  remove   Boolean?

  @@map("sms_sablonlari")
}

/** Vega ERP entegrasyon — tek satır */
model ErpEntegrasyon {
  id             Int      @id @default(autoincrement())
  server         String   @db.VarChar(255)
  veritabani     String   @db.VarChar(255)
  kullaniciadi   String   @db.VarChar(255)
  password       String   @db.VarChar(255)
  apiUrl         String?  @map("api_url") @db.VarChar(255)
  apiSecret      String?  @map("api_secret") @db.VarChar(255)
  firma          String?  @db.VarChar(255)
  donem          String?  @db.VarChar(255)
  sube           String?  @db.VarChar(255)
  depo           String?  @db.VarChar(255)
  kasa           String?  @db.VarChar(255)
  durum          Boolean?
  envanter       Boolean?
  parametreDurum String?  @map("parametre_durum") @db.LongText

  @@map("erp_entegrasyon_bilgileri")
}

/** Firma iletişim bilgileri — tek satır */
model IletisimBilgileri {
  id      Int     @id @default(autoincrement())
  vdId    Int?    @map("vd_id")
  adres   String  @db.LongText
  telefon String  @db.VarChar(255)
  gsm     String? @db.VarChar(255)
  fax     String? @db.VarChar(255)
  eposta  String  @db.VarChar(255)
  unvan   String? @db.VarChar(255)
  vn      String? @db.VarChar(255)
  /** 0=gerçek, 1=tüzel, 2=yabancı */
  tip     Int?

  @@map("iletisim_bilgileri")
}

/** Vergi daireleri — iletişim formu seçenekleri */
model VergiDairesi {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  ilAdi   String?  @map("il_adi") @db.VarChar(255)
  ilceAdi String?  @map("ilce_adi") @db.VarChar(255)
  remove  Boolean?

  @@map("vergi_daireleri")
}

