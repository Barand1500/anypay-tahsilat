generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Mevcut `user` tablosu — dump referans; alanlar ihtiyaca göre genişletilir
model User {
  id               Int       @id @default(autoincrement())
  musteriId        Int?      @map("musteri_id")
  email            String    @unique @db.VarChar(180)
  isVerified       Boolean   @map("is_verified")
  isPassword       Boolean   @map("is_password")
  roles            Json
  password         String    @db.VarChar(255)
  adsoyad          String?   @db.VarChar(255)
  unvan            String?   @db.VarChar(255)
  telefon          String    @db.VarChar(255)
  resim            String?   @db.VarChar(255)
  remove           Boolean?
  resetToken       String?   @map("reset_token") @db.VarChar(255)
  karMarji         Float?    @map("kar_marji")
  dogrulama        String?   @db.VarChar(255)
  fbToken          String?   @map("fb_token") @db.VarChar(255)
  lastLogin        DateTime? @map("last_login")
  appleId          String?   @map("apple_id") @db.LongText
  googleId         String?   @map("google_id") @db.LongText
  vegaEntegre      Boolean?  @map("vega_entegre")
  twoFactor        Boolean?  @map("two_factor")
  twoFactorType    Int?      @map("two_factor_type")
  subeDepartmanId  Int?      @map("sube_departman_id")
  rolId            Int?      @map("rol_id")
  izinliTaksitler  String?   @map("izinli_taksitler") @db.LongText

  @@map("user")
}

/** Panel modül kayıtları — eski PHP “İzinler” */
model Izinler {
  id              Int       @id @default(autoincrement())
  adi             String    @db.VarChar(255)
  olusturmaTarihi DateTime? @map("olusturma_tarihi")
  remove          Boolean?
  tablo           String?   @db.VarChar(255)
  route           String?   @db.VarChar(255)

  @@map("izinler")
}

/** Roller — izinler alanı PHP serialize (yalnızca okunur bu fazda) */
model Rol {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  code    String   @db.VarChar(255)
  remove  Boolean?
  izinler String?  @db.LongText
  yetki   Int?

  @@map("rol")
}

/** Şube / departman */
model SubeDepartman {
  id              Int      @id @default(autoincrement())
  adi             String   @db.VarChar(255)
  info            String?  @db.LongText
  remove          Boolean?
  izinliTaksitler String?  @map("izinli_taksitler") @db.LongText

  @@map("sube_departman")
}

/** Sürüm geçmişi */
model Surumler {
  id              Int       @id @default(autoincrement())
  tarih           DateTime
  versionNumarasi Float     @map("version_numarasi")
  eklenen         String?   @db.LongText
  cikartilan      String?   @db.LongText
  remove          Boolean?
  duzeltilen      String?   @db.LongText
  durum           Boolean?

  @@map("surumler")
}

/** Panel işlem logları */
model Log {
  id          Int      @id @default(autoincrement())
  kullaniciId Int?     @map("kullanici_id")
  tarih       DateTime
  islem       String?  @db.LongText

  @@map("log")
}

/** E-posta / SMS gönderim geçmişi */
model GonderimGecmisi {
  id        Int      @id @default(autoincrement())
  musteriId Int?     @map("musteri_id")
  tip       String   @db.VarChar(16)
  alici     String   @db.VarChar(255)
  icerik    String?  @db.LongText
  tarih     DateTime
  kaynak    String?  @db.VarChar(64)
  refId     Int?     @map("ref_id")
  basarili  Boolean  @default(true)

  @@index([tarih])
  @@index([musteriId])
  @@map("gonderim_gecmisi")
}

/** Müşteriler / cari hesaplar */
model Musteri {
  id              Int       @id @default(autoincrement())
  kisaAdi         String?   @map("kisa_adi") @db.VarChar(255)
  firmaKodu       String?   @map("firma_kodu") @db.VarChar(255)
  unvan           String?   @db.VarChar(255)
  vn              String?   @db.VarChar(255)
  telefon         String?   @db.VarChar(255)
  eposta          String?   @db.VarChar(255)
  remove          Boolean?
  info            String?   @db.LongText
  vd              Int?
  webSitesi       String?   @map("web_sitesi") @db.VarChar(255)
  tc              String?   @db.VarChar(255)
  pasaportNo      String?   @map("pasaport_no") @db.VarChar(255)
  /** 0=gerçek, 1=tüzel, 2=yabancı */
  musteriTipi     Int?      @map("musteri_tipi")
  cariTipiId      Int?      @map("cari_tipi_id")
  vegaId          Int?      @map("vega_id")
  vegaEntegre     Boolean?  @map("vega_entegre")
  vegaTarih       DateTime? @map("vega_tarih")
  durum           Int?
  ustid           Int?
  adres           String?   @db.LongText
  kartAnlasmaKodu String?   @map("kart_anlasma_kodu") @db.VarChar(255)

  @@map("musteriler")
}

/** Cari tipi (Müşteri, Bayi…) */
model CariTipi {
  id     Int      @id @default(autoincrement())
  adi    String   @db.VarChar(255)
  remove Boolean?

  @@map("cari_tipleri")
}

/** Bankalar */
model Banka {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  kisaAdi String   @map("kisa_adi") @db.VarChar(255)
  logo    String?  @db.VarChar(255)
  remove  Boolean?

  @@map("bankalar")
}

/**
 * Ödemeler / hareketler
 * durum: 1=başarılı, 2=iptal/iade, 0|-1=hatalı
 * odeme_tipi: 0=C/H, 2=fatura (dump)
 */
model Odeme {
  id               Int       @id @default(autoincrement())
  parabirimiId     Int       @map("parabirimi_id")
  musteriId        Int?      @map("musteri_id")
  tutar            Float
  kur              Float?
  komisyonDahil    Boolean   @map("komisyon_dahil")
  aciklama         String?   @db.LongText
  adsoyad          String    @db.VarChar(255)
  tc               String?   @db.VarChar(255)
  telefon          String    @db.VarChar(255)
  kartNo           String    @map("kart_no") @db.VarChar(255)
  taksit           Int?
  taksitOran       Float?    @map("taksit_oran")
  vadeFarki        Float?    @map("vade_farki")
  odemeNo          String    @map("odeme_no") @db.VarChar(255)
  durum            Int
  bankaCevabi      String?   @map("banka_cevabi") @db.LongText
  odemeTipi        Int       @map("odeme_tipi")
  faturaNo         String?   @map("fatura_no") @db.VarChar(255)
  bankError        String?   @map("bank_error") @db.LongText
  tarih            DateTime?
  ip               String?   @db.VarChar(255)
  tahsilGunu       String?   @map("tahsil_gunu") @db.VarChar(255)
  blokeGunu        String?   @map("bloke_gunu") @db.VarChar(255)
  taksitDetay      String?   @map("taksit_detay") @db.LongText
  bankaId          Int?      @map("banka_id")
  sanalposBankaId  Int?      @map("sanalpos_banka_id")
  kurulusId        Int?      @map("kurulus_id")
  bankaKomisyonu   Float?    @map("banka_komisyonu")
  blokeTarih       DateTime? @map("bloke_tarih")
  arsiv            Boolean?
  subeDepartmanId  Int?      @map("sube_departman_id")
  kullaniciId      Int?      @map("kullanici_id")
  iptalIadeHareket String?   @map("iptal_iade_hareket") @db.LongText
  gercekTutar      Float     @map("gercek_tutar")
  epostaGonderildi Int?      @map("eposta_gonderildi")
  smsGonderildi    Int?      @map("sms_gonderildi")

  @@map("odemeler")
}

/** Ödeme istekleri — durum: 0=bekleyen, 1=ödendi */
model OdemeIstegi {
  id              Int       @id @default(autoincrement())
  parabirimiId    Int       @map("parabirimi_id")
  odemeTipi       Int       @map("odeme_tipi")
  tutar           Float
  faturaNo        String?   @map("fatura_no") @db.VarChar(255)
  komisyonDahil   Boolean   @map("komisyon_dahil")
  taksitler       String?   @db.LongText
  aciklama        String?   @db.LongText
  dosya           String?   @db.LongText
  musteriId       Int?      @map("musteri_id")
  tarih           DateTime
  odemeZamani     DateTime? @map("odeme_zamani")
  durum           Boolean
  istekNo         String    @map("istek_no") @db.VarChar(255)
  kullaniciId     Int?      @map("kullanici_id")
  subeDepartmanId Int?      @map("sube_departman_id")
  remove          Boolean?
  qr              String?   @db.VarChar(255)

  @@map("odeme_istekleri")
}

/** Genel sistem ayarları — tek satır (id=1) */
model Ayarlar {
  id                     Int       @id @default(autoincrement())
  sistemAdi              String    @map("sistem_adi") @db.VarChar(255)
  sistemYolu             String    @map("sistem_yolu") @db.VarChar(255)
  logo                   String    @db.VarChar(255)
  favicon                String    @db.VarChar(255)
  sistemPosta            String    @map("sistem_posta") @db.VarChar(255)
  sanalposHedefKullanimi Boolean?  @map("sanalpos_hedef_kullanimi")
  surum                  String?   @db.VarChar(255)
  dbTarih                DateTime? @map("db_tarih")
  bildirimEpostalar      String?   @map("bildirim_epostalar") @db.LongText
  bildirimSmsler         String?   @map("bildirim_smsler") @db.LongText
  binListLink            String?   @map("bin_list_link") @db.VarChar(255)
  ilkBankaCekim          Boolean?  @map("ilk_banka_cekim")
  uygulamaKayit          Boolean?  @map("uygulama_kayit")

  @@map("ayarlar")
}

/** Firma iletişim bilgileri — tek satır */
model IletisimBilgileri {
  id      Int     @id @default(autoincrement())
  vdId    Int?    @map("vd_id")
  adres   String  @db.LongText
  telefon String  @db.VarChar(255)
  gsm     String? @db.VarChar(255)
  fax     String? @db.VarChar(255)
  eposta  String  @db.VarChar(255)
  unvan   String? @db.VarChar(255)
  vn      String? @db.VarChar(255)
  /** 0=gerçek, 1=tüzel, 2=yabancı */
  tip     Int?

  @@map("iletisim_bilgileri")
}

/** Vergi daireleri — iletişim formu seçenekleri */
model VergiDairesi {
  id     Int      @id @default(autoincrement())
  adi    String   @db.VarChar(255)
  remove Boolean?

  @@map("vergi_daireleri")
}

/** Müşteri adresleri */
model Adres {
  id          Int      @id @default(autoincrement())
  musteriId   Int?     @map("musteri_id")
  adresTarifi String?  @map("adres_tarifi") @db.LongText
  ulkeId      Int      @map("ulke_id")
  ilId        Int      @map("il_id")
  ilceId      Int      @map("ilce_id")
  semtId      Int      @map("semt_id")
  mahalleId   Int      @map("mahalle_id")
  sokakId     Int      @map("sokak_id")
  adresAdi    String   @map("adres_adi") @db.VarChar(255)
  remove      Boolean?
  yetkili     String?  @db.LongText
  varsayilan  Boolean?

  @@map("adresler")
}

model Ulke {
  id         Int      @id @default(autoincrement())
  adi        String   @db.VarChar(255)
  info       String?  @db.LongText
  remove     Boolean?
  telefonKodu String  @map("telefon_kodu") @db.VarChar(255)

  @@map("ulke")
}

model Il {
  id       Int      @id @default(autoincrement())
  ulkeId   Int?     @map("ulke_id")
  adi      String   @db.VarChar(255)
  remove   Boolean?
  info     String?  @db.LongText
  plakaKodu String? @map("plaka_kodu") @db.VarChar(255)

  @@map("il")
}

model Ilce {
  id     Int      @id @default(autoincrement())
  ilId   Int      @map("il_id")
  adi    String   @db.VarChar(255)
  remove Boolean?
  info   String?  @db.LongText

  @@map("ilce")
}

model Semt {
  id     Int      @id @default(autoincrement())
  ilceId Int      @map("ilce_id")
  adi    String   @db.VarChar(255)
  remove Boolean?
  info   String?  @db.LongText

  @@map("semt")
}

model Mahalle {
  id        Int      @id @default(autoincrement())
  semtId    Int      @map("semt_id")
  adi       String   @db.VarChar(255)
  postaKodu String   @map("posta_kodu") @db.VarChar(255)
  remove    Boolean?
  info      String?  @db.LongText

  @@map("mahalle")
}

model Sokak {
  id        Int      @id @default(autoincrement())
  mahalleId Int      @map("mahalle_id")
  adi       String   @db.VarChar(255)
  remove    Boolean?

  @@map("sokak")
}
