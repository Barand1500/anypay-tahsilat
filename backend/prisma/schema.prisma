generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Mevcut `user` tablosu — dump referans; alanlar ihtiyaca göre genişletilir
model User {
  id               Int       @id @default(autoincrement())
  musteriId        Int?      @map("musteri_id")
  email            String    @unique @db.VarChar(180)
  isVerified       Boolean   @map("is_verified")
  isPassword       Boolean   @map("is_password")
  roles            Json
  password         String    @db.VarChar(255)
  adsoyad          String?   @db.VarChar(255)
  unvan            String?   @db.VarChar(255)
  telefon          String    @db.VarChar(255)
  resim            String?   @db.VarChar(255)
  remove           Boolean?
  resetToken       String?   @map("reset_token") @db.VarChar(255)
  karMarji         Float?    @map("kar_marji")
  dogrulama        String?   @db.VarChar(255)
  fbToken          String?   @map("fb_token") @db.VarChar(255)
  lastLogin        DateTime? @map("last_login")
  appleId          String?   @map("apple_id") @db.LongText
  googleId         String?   @map("google_id") @db.LongText
  vegaEntegre      Boolean?  @map("vega_entegre")
  twoFactor        Boolean?  @map("two_factor")
  twoFactorType    Int?      @map("two_factor_type")
  subeDepartmanId  Int?      @map("sube_departman_id")
  rolId            Int?      @map("rol_id")
  izinliTaksitler  String?   @map("izinli_taksitler") @db.LongText

  @@map("user")
}

/** Panel modül kayıtları — eski PHP “İzinler” */
model Izinler {
  id              Int       @id @default(autoincrement())
  adi             String    @db.VarChar(255)
  olusturmaTarihi DateTime? @map("olusturma_tarihi")
  remove          Boolean?
  tablo           String?   @db.VarChar(255)
  route           String?   @db.VarChar(255)

  @@map("izinler")
}

/** Roller — izinler alanı PHP serialize (yalnızca okunur bu fazda) */
model Rol {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  code    String   @db.VarChar(255)
  remove  Boolean?
  izinler String?  @db.LongText
  yetki   Int?

  @@map("rol")
}

/** Şube / departman */
model SubeDepartman {
  id              Int      @id @default(autoincrement())
  adi             String   @db.VarChar(255)
  info            String?  @db.LongText
  remove          Boolean?
  izinliTaksitler String?  @map("izinli_taksitler") @db.LongText

  @@map("sube_departman")
}

/** Sürüm geçmişi */
model Surumler {
  id              Int       @id @default(autoincrement())
  tarih           DateTime
  versionNumarasi Float     @map("version_numarasi")
  eklenen         String?   @db.LongText
  cikartilan      String?   @db.LongText
  remove          Boolean?
  duzeltilen      String?   @db.LongText
  durum           Boolean?

  @@map("surumler")
}

/** Panel işlem logları */
model Log {
  id          Int      @id @default(autoincrement())
  kullaniciId Int?     @map("kullanici_id")
  tarih       DateTime
  islem       String?  @db.LongText

  @@map("log")
}

/** Müşteriler */
model Musteri {
  id        Int      @id @default(autoincrement())
  kisaAdi   String?  @map("kisa_adi") @db.VarChar(255)
  unvan     String?  @db.VarChar(255)
  remove    Boolean?
  durum     Int?

  @@map("musteriler")
}

/** Bankalar */
model Banka {
  id      Int      @id @default(autoincrement())
  adi     String   @db.VarChar(255)
  kisaAdi String   @map("kisa_adi") @db.VarChar(255)
  logo    String?  @db.VarChar(255)
  remove  Boolean?

  @@map("bankalar")
}

/**
 * Ödemeler / hareketler
 * durum: 1=başarılı, 2=iptal/iade, 0|-1=hatalı
 */
model Odeme {
  id                Int       @id @default(autoincrement())
  musteriId         Int?      @map("musteri_id")
  tutar             Float
  gercekTutar       Float     @map("gercek_tutar")
  durum             Int
  tarih             DateTime?
  bankaId           Int?      @map("banka_id")
  sanalposBankaId   Int?      @map("sanalpos_banka_id")
  subeDepartmanId   Int?      @map("sube_departman_id")
  kullaniciId       Int?      @map("kullanici_id")
  arsiv             Boolean?
  iptalIadeHareket  String?   @map("iptal_iade_hareket") @db.LongText

  @@map("odemeler")
}

/** Ödeme istekleri — durum: 0=bekleyen, 1=ödendi */
model OdemeIstegi {
  id              Int       @id @default(autoincrement())
  tutar           Float
  durum           Boolean
  tarih           DateTime
  kullaniciId     Int?      @map("kullanici_id")
  subeDepartmanId Int?      @map("sube_departman_id")
  remove          Boolean?

  @@map("odeme_istekleri")
}
